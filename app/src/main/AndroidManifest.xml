<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Offline by construction: no INTERNET or other network permission, in any
         build type. scripts/verify_offline.sh fails if one appears in a built APK. -->

    <!-- For questions about "near me". The satellite receiver only listens, so
         this works in airplane mode, and with no network permission the position
         cannot leave the phone. Asked for only when such a question comes up. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="Offline Research"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
